<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <!-- the controllers are picked up by the org.geoserver.pgstac scan in gs-pgstac-core -->

  <bean id="pgstacRestExtension" class="org.geoserver.platform.ModuleStatusImpl">
    <constructor-arg index="0" value="gs-pgstac-rest"/>
    <constructor-arg index="1" value="PgSTAC REST configuration API"/>
  </bean>
</beans>
