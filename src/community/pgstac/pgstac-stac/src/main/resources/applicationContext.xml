<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <!-- PgStacSTACService itself is picked up by the org.geoserver.pgstac scan in gs-pgstac-core -->

  <!-- Bridges the OGC API service to an OWS service, the name must match the @APIService one -->
  <bean id="pgstacServiceFactory" class="org.geoserver.ogcapi.APIServiceFactoryBean">
    <constructor-arg index="0" value="${pgstac.service.name:STAC}"/>
    <constructor-arg index="1" value="1.0.0"/>
  </bean>

  <bean id="pgstacStacExtension" class="org.geoserver.platform.ModuleStatusImpl">
    <constructor-arg index="0" value="gs-pgstac-stac"/>
    <constructor-arg index="1" value="PgSTAC STAC API"/>
  </bean>
</beans>
