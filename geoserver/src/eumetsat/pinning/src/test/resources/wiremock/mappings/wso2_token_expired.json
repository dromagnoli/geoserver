{
  "scenarioName": "WSO2",
  "requiredScenarioState": "TOKEN_EXPIRED",
  "request": {
    "method": "POST",
    "urlPath": "/auth/wso2/token",
    "headers": {
      "Authorization": {
        "matches": "Basic cGlubmluZy1zZXJ2aWNlOnBpbm5pbmdzZXJ2aWNld3NvMnNlY3JldA=="
      },
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "bodyPatterns": [
      {
        "contains": "grant_type=client_credentials"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "expired-mock-token",
      "token_type": "Bearer",
      "expires_in": 0,
      "scope": "read"
    }
  }
}